# Server
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Database and authentication
MONGO_URI=mongodb://127.0.0.1:27017/venroh
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OFFICIAL_ADMIN_EMAIL=admin@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PITCH_FOLDER=startup-pitches
CLOUDINARY_CHAT_FOLDER=chat-files

# Upload limits (bytes)
MAX_PITCH_DECK_BYTES=52428800
MAX_CHAT_FILE_BYTES=5368709120

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Twilio video/communications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# External services
CUFINDER_API_KEY=
GEMINI_API_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
